# macOS
.DS_Store

# Xcode user data
*.xcuserdatad/
xcuserdata/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/

# IDE
.idea/
.vscode/
*.swp

# Environment
.env*
!.env.example

# Local verification artifacts
.tmp*

# MCP / local tooling config
.mcp.json
.codex/
# Machine-specific Claude Code settings (contains absolute paths)
.claude/settings.local.json

# Dev-server / debug temp files (logs, screenshots, scratch HTML, browser
# profile dirs left behind by debug scripts). These are local-only and
# should never be committed.
.tmp-*

# Generated output (e.g. output/pdf/, output/live-eval/ raw evaluation
# results) — never committed. LIVE-EVAL-4 (ABC-JEV-INTEGRATION.md §1w
# "Fix now"): this was untracked only by omission before this line existed.
/output/
# The live-channels runner executes from web/, so its raw results land in
# web/output/live-eval/ — ignored for the same reason (manager fix after the
# LIVE-EVAL-4 C smoke run showed web/output/ untracked and NOT ignored).
/web/output/
