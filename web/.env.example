# Peer — names of the environment variables the web app reads. Values live in
# .env.local, which is never committed. Provider keys are entered by each reader
# in the app, not here.

# Full-text discovery. Unpaywall and OpenAlex ask for a contact address on every
# request; without one the Unpaywall lookup is skipped and OpenAlex is called
# unidentified. Set to your own address.
UNPAYWALL_EMAIL=
OPENALEX_EMAIL=

# Optional: the Python interpreter for the PDF text extractor, when it is not
# `python3` on PATH. A deployment with no interpreter reads no PDFs and says so.
PYTHON_BIN=

# Optional. Unset or anything other than "tiered" runs beta's single-plan
# mode: every signed-in reader is treated as paid, capped only by the shared
# daily breaker. Set to exactly "tiered" (after beta ends) to restore the
# free/trial/paid split built in ABC-freemium rounds 1-9 — a live trial stays
# a trial, an expired one drops to free, and each plan gets its own deep-report
# budget again. See entitlementMode() in src/lib/entitlement/resolve.ts.
PEER_ENTITLEMENT_MODE=
