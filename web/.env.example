# Peer — names of the environment variables the web app reads. Values live in
# .env.local, which is never committed. Provider keys are entered by each reader
# in the app, not here.

# Full-text discovery. Unpaywall and OpenAlex ask for a contact address on every
# request; without one the Unpaywall lookup is skipped and OpenAlex is called
# unidentified. Set to your own address.
UNPAYWALL_EMAIL=
OPENALEX_EMAIL=

# Optional: the Python interpreter for the PDF text extractor, when it is not
# `python3` on PATH. A deployment with no interpreter reads no PDFs and says so.
PYTHON_BIN=

# Hosted PDFs: disabled unless explicitly enabled with a private durable volume
# OUTSIDE the served application directory. See docs/PRIVATE_PDF_UPLOADS.md.
# Use an encrypted volume, an authenticated deployment, and a daily call to
# /api/jobs/purge-uploads with Authorization: Bearer <CRON_SECRET>.
PEER_UPLOADS_ENABLED=false
PEER_PRIVATE_UPLOAD_DIR=

# 9-18: the bearer /api/jobs/purge-uploads and web/scripts/purge-uploads.mjs
# both require. On Vercel, set this in the project's environment variables —
# Vercel's own cron caller (repo-root vercel.json) then sends it
# automatically, nothing else to wire up. Self-hosting: set it here (or in
# the shell that runs `npm run purge-uploads`) and call that script on your
# own OS-level scheduler; nothing in this repo runs it for you. Never commit
# a real value.
CRON_SECRET=
